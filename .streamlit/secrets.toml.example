# Copier ces lignes dans Streamlit Community Cloud : App > Settings > Secrets
# (ne jamais mettre ce fichier rempli sur GitHub)

# Facultatif : protège l'accès à l'application par un mot de passe
APP_PASSWORD = "choisir-un-mot-de-passe"

# Rédaction assistée : renseigner UNE des deux clés.
# Albert, API IA de l'État (https://guides.ia.numerique.gouv.fr/albert-api/) — prioritaire si présente
ALBERT_API_KEY = "votre-cle-albert"
# ou Claude (https://console.anthropic.com) — une clé Anthropic commence par sk-ant-
# ANTHROPIC_API_KEY = "sk-ant-..."

# Facultatif : modèle utilisé. Par défaut « openweight-large » pour Albert (généraliste, gpt-oss-120b)
# et « claude-sonnet-5-5 » pour Claude. Liste des modèles Albert :
# https://guides.ia.numerique.gouv.fr/albert-api/modeles/available-models
# MODELE = "openweight-large"
