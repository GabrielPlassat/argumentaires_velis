# Copier ces lignes dans Streamlit Community Cloud : App > Settings > Secrets
# (ne jamais mettre ce fichier rempli sur GitHub)

# Facultatif : protège l'accès à l'application par un mot de passe
APP_PASSWORD = "choisir-un-mot-de-passe"

# Facultatif : active l'onglet « Rédaction assistée » (clé créée sur https://console.anthropic.com)
ANTHROPIC_API_KEY = "sk-ant-..."

# Facultatif : modèle Claude utilisé pour la rédaction (vérifier les noms sur https://docs.claude.com)
MODELE = "claude-sonnet-5-5"
