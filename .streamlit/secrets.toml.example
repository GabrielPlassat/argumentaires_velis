# Copier ces lignes dans Streamlit Community Cloud : App > Settings > Secrets
# (ne jamais mettre ce fichier rempli sur GitHub)

# Facultatif : protège l'accès à l'application par un mot de passe
APP_PASSWORD = "choisir-un-mot-de-passe"

# Rédaction assistée : une clé ou les deux. Avec les deux, un sélecteur permet de choisir l'IA.
# Albert, API IA de l'État (https://guides.ia.numerique.gouv.fr/albert-api/)
ALBERT_API_KEY = "votre-cle-albert"
# Claude (https://console.anthropic.com > API Keys) — la clé commence par sk-ant-
ANTHROPIC_API_KEY = "sk-ant-..."

# Facultatif : modèle de chaque IA (sinon : openweight-large pour Albert, claude-sonnet-5-5 pour Claude)
# MODELE_ALBERT = "openweight-large"
# MODELE_CLAUDE = "claude-sonnet-5-5"
